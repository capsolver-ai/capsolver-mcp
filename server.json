{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.capsolver-ai/capsolver-mcp",
  "description": "MCP Server for CapSolver - captcha-solving capabilities for AI agents",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/capsolver-ai/capsolver-mcp",
    "source": "github"
  },
  "websiteUrl": "https://capsolver.com",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "capsolver-mcp",
      "version": "0.1.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CAPSOLVER_API_KEY",
          "description": "Your CapSolver API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
